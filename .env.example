# === ChatYuk secrets template ===
# Copy ke .env lalu isi nilainya. JANGAN commit .env (sudah di .gitignore).

# Supabase Management API token (sbp_...) — akses penuh ke project.
# Ambil di: Supabase Dashboard > Account > Access Tokens
SUPABASE_ACCESS_TOKEN=

# Project ref + URL
SUPABASE_PROJECT_REF=
SUPABASE_URL=

# Publishable key (aman untuk client — dilindungi RLS)
SUPABASE_PUBLISHABLE_KEY=

# === Android signing ===
KEYSTORE_PASS=
KEY_PASS=

# === TikTok App Events (Business) SDK — TikTok Ads ===
# App ID = package name; TikTok App ID & Access Token dari TikTok Events
# Manager (https://ads.tiktok.com/i18n/events_manager). Lihat docs/TIKTOK_SDK.md.
# Access Token disuntik saat BUILD (tidak dibaca runtime):
#   --dart-define=TIKTOK_ACCESS_TOKEN=<access-token>
TIKTOK_APP_ID=com.chatyuk.chatyuk
TIKTOK_TT_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
