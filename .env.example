# === ChatYuk secrets template ===
# Copy ke .env lalu isi nilainya. JANGAN commit .env (sudah di .gitignore).

# Supabase Management API token (sbp_...) — akses penuh ke project.
# Ambil di: Supabase Dashboard > Account > Access Tokens
SUPABASE_ACCESS_TOKEN=

# Project ref + URL
SUPABASE_PROJECT_REF=
SUPABASE_URL=

# Publishable key (aman untuk client — dilindungi RLS)
SUPABASE_PUBLISHABLE_KEY=

# === Android signing ===
KEYSTORE_PASS=
KEY_PASS=

# === Midtrans (Edge Function topup-create / topup-webhook) ===
# Set via: supabase secrets set MIDTRANS_SERVER_KEY=... MIDTRANS_IS_PRODUCTION=false
# Server Key & Client Key ada di: Midtrans Dashboard > Settings > Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false

# === Midtrans Dashboard (MAP) login — akses dashboard untuk ambil token ===
# URL: https://dashboard.midtrans.com/login
# JANGAN simpan kredensial dashboard di repo — rotasi password bila
# pernah ter-commit. Hanya referensi URL.
# MIDTRANS_DASHBOARD_USERNAME=<email-admin>

# === iPaymu (payment gateway AKTIF untuk top-up koin) ===
# Set via: supabase secrets set IPAYMU_VA=... IPAYMU_API_KEY=... IPAYMU_IS_PRODUCTION=true
# Kredensial dari: my.ipaymu.com > Integrasi (menu kiri).
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_IS_PRODUCTION=false
