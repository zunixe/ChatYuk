rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    function validText(max) {
      return request.resource.data.text is string
        && request.resource.data.text.size() <= max;
    }

    // users: hanya pemilik yang bisa baca/tulis. avatar & fcmToken hanya di sini.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 30;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['avatar', 'fcmToken', 'status', 'lastSeen']);
      allow delete: if false;
    }

    // rooms: read untuk semua yang login; write HANYA via server (admin SDK).
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow write: if false;

      match /messages/{msgId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 30
          && validText(1000)
          && request.resource.data.timestamp is timestamp;
        allow update, delete: if false;
      }
    }

    // roomMemberships: catatan join untuk notifikasi room.
    // Hanya bisa mencatat dirinya sendiri.
    match /roomMemberships/{docId} {
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.roomId is string;
      allow read: if signedIn();
      allow delete: if false;
    }

    // privateChats: hanya peserta; create divalidasi; riwayat tidak bisa dihapus.
    match /privateChats/{chatId} {
      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participants;
      }
      function isChatParticipant() {
        return signedIn() && request.auth.uid in get(/databases/$(database)/documents/privateChats/$(chatId)).data.participants;
      }
      allow create: if signedIn()
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participantNames is map;
      allow read: if isParticipant();
      allow update: if isParticipant()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'lastMessageAt']);
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isChatParticipant();
        allow create: if isChatParticipant()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 30
          && validText(1000)
          && request.resource.data.timestamp is timestamp
          && (!request.resource.data.keys().hasAny(['imageData'])
              || request.resource.data.imageData.size() <= 1500000);
        allow update, delete: if false;
      }
    }

    // blocks: hanya pemilik list-nya
    match /blocks/{userId} {
      allow read, create, update, delete: if isOwner(userId);
      match /blocked/{blockedId} {
        allow read, write: if isOwner(userId);
      }
    }

    // reports: hanya create (read untuk admin via server SDK)
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reportedId is string
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500;
      allow read, update, delete: if false;
    }
  }
}
