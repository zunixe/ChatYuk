<?xml version="1.0" encoding="utf-8"?>
<!-- Splash cold start: background gelap + logo ChatYuk di tengah.
     File v21 ini yang dipakai semua HP modern (base drawable/ diabaikan).
     Ukuran/logo SAMA dengan overlay programmatik MainActivity agar mulus. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_bg" />

    <item
        android:width="120dp"
        android:height="120dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
